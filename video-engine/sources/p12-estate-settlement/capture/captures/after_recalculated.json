 "00_START_HERE": {
  "A1": "ESTATE SETTLEMENT COMMAND CENTER",
  "A2": "A connected workspace for organizing an estate after a death: tasks, assets, liabilities, transactions, documents, contacts, beneficiary records, a cash reconciliation check, and a closeout review \u2014 all in one place, updating automatically as you enter records.",
  "A4": "Estate / Reference Name",
  "B4": "Estate of Walter H. Doyle (sample)",
  "A5": "Date of Death",
  "B5": "2026-06-19 00:00:00",
  "A6": "Jurisdiction (free text)",
  "B6": "Cook County, Illinois (example only -- enter your own)",
  "A7": "Executor / Administrator Name",
  "B7": "Nadia Doyle",
  "A8": "Starting Estate Cash",
  "B8": 4200,
  "A9": "Actual Estate Cash Balance (as of today, from your bank statement)",
  "B9": 9430,
  "A11": "\u26a0 DO NOT double-count Starting Estate Cash as a transaction inflow on 05_ESTATE_TRANSACTIONS \u2014 it is the opening balance, entered once, here only.",
  "A13": "QUICK NAVIGATION \u2014 click a tab name to jump there",
  "A14": "\u2192 01_COMMAND_CENTER",
  "A15": "\u2192 02_ACTION_ROADMAP",
  "A16": "\u2192 03_ASSET_REGISTER",
  "A17": "\u2192 04_LIABILITY_REGISTER",
  "A18": "\u2192 05_ESTATE_TRANSACTIONS",
  "A19": "\u2192 06_EXPENSES_REIMBURSEMENTS",
  "A20": "\u2192 07_DOCUMENT_CONTROL",
  "A21": "\u2192 08_CONTACTS_COMMUNICATION",
  "A22": "\u2192 09_BENEFICIARIES_DISTRIBUTIONS",
  "A23": "\u2192 10_RECONCILIATION",
  "A24": "\u2192 11_CLOSEOUT_REVIEW",
  "A25": "\u2192 12_REPORTS_PRINT",
  "A27": "5-MINUTE SETUP",
  "A28": "STEP 1: Fill in the estate details above (name, date of death, executor, starting cash).",
  "A29": "STEP 2: Go to 02_ACTION_ROADMAP and list your tasks (or keep the sample ones as a starting checklist).",
  "A30": "STEP 3: Go to 03_ASSET_REGISTER and 04_LIABILITY_REGISTER and list what the estate owns and owes.",
  "A31": "STEP 4: Log every deposit and payment on 05_ESTATE_TRANSACTIONS as it happens.",
  "A32": "STEP 5: Check 01_COMMAND_CENTER \u2014 everything else updates automatically from what you enter.",
  "A34": "WHAT THE COLORS MEAN",
  "A35": "YELLOW",
  "B35": "YOU TYPE HERE.",
  "A36": "WHITE",
  "B36": "AUTOMATIC \u2014 calculated for you. Don't type over these.",
  "A38": "WHAT THIS WORKBOOK IS NOT",
  "A39": "This is an organizational recordkeeping tool only. It does NOT determine whether probate is required, creditor priority, legal beneficiary entitlement, taxes owed, or legal distribution timing, and it does not tell you an estate is legally ready to close. \"Organization Complete\" on 11_CLOSEOUT_REVIEW means this workbook's own organizational flags are clear \u2014 nothing more. Always consult a qualified attorney or accountant for legal, tax, or probate questions."
 },
