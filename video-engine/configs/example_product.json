{
  "_README": "Copy to configs/productNN_<slug>.json and replace every REPLACE_ value. Coordinates are [x, y, w, h] in SOURCE-image pixels (find them with tools/locate.py). Camera rects are auto-fitted to the card aspect (2.095:1). Run: python render_video.py configs/productNN_<slug>.json --validate-only",
  "schema": "ledger-lime-video/1",
  "template": "ledger_lime",
  "product": {
    "id": "pNN-REPLACE-slug",
    "number": 0,
    "title": "REPLACE Product Title",
    "version": "V1"
  },
  "output": {
    "filename": "PNN-REPLACE-Etsy-Video-V1.mp4",
    "fps": 30,
    "min_duration": 12,
    "max_duration": 15
  },
  "provenance": {
    "source_status": "product_capture",
    "pointer_rendered": false,
    "notes": "REPLACE: where the captures came from (file name, date) and what single input causes the change."
  },
  "truth": {
    "states": {
      "before": {"primary_value": "REPLACE e.g. 60%", "status": "REPLACE e.g. No Recent Data", "count": "REPLACE e.g. 2"},
      "after":  {"primary_value": "REPLACE e.g. 90%", "status": "REPLACE e.g. Improving", "count": "REPLACE e.g. 1"}
    },
    "labels": {"primary_value": "REPLACE chip label", "status": "Status", "count": "REPLACE chip label"},
