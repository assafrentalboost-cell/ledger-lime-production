  },
  "sources": {
    "dash_before": {"path": "sources/pNN-REPLACE/captures/before_dashboard.png"},
    "dash_after":  {"path": "sources/pNN-REPLACE/captures/after_dashboard.png"},
    "input_after": {"path": "sources/pNN-REPLACE/captures/after_input.png"}
  },
  "scenes": [
    {
      "id": "problem-before",
      "type": "screen",
      "duration": 2.5,
      "source": "dash_before",
      "caption": "REPLACE problem caption.",
      "camera": {"from": [0, 0, 2400, 1146], "to": [100, 50, 2200, 1050]},
      "highlights": [
        {"find": "REPLACE text to ring", "expand": [20, 12, 20, 12], "appear": 0.4}
      ],
      "expect_text": [{"at": 2.0, "text": ["REPLACE problem caption"]}]
    },
    {
      "id": "real-input",
      "type": "screen",
      "duration": 3.5,
      "source": "input_after",
      "caption": "REPLACE input caption.",
      "camera": {"from": [0, 0, 2400, 1146], "to": [0, 200, 2000, 955]},
      "highlights": [{"rect": [0, 0, 100, 50], "appear": 1.2}]
    },
    {
      "id": "automatic-change",
      "type": "morph",
      "duration": 3.0,
      "source_from": "dash_before",
      "source_to": "dash_after",
      "swap_at": 0.8,
      "swap_duration": 0.6,
      "caption": "Updates automatically.",
      "camera": {"from": [0, 0, 2400, 1146], "to": [200, 100, 2000, 955]},
      "highlights": [{"rect": [0, 0, 100, 50], "appear": 0.3}],
      "chips": [
        {"truth_key": "primary_value", "anchor": "bottom-left", "appear": 1.5},
        {"truth_key": "status", "anchor": "bottom-left", "appear": 1.7}
      ]
    },
    {
      "id": "buyer-outcome",
      "type": "screen",
      "duration": 3.0,
      "source": "dash_after",
      "caption": "REPLACE outcome caption.",
      "camera": {"from": [0, 0, 2400, 1146], "to": [100, 50, 2200, 1050]},
      "highlights": [{"rect": [0, 0, 100, 50], "appear": 0.4}],
      "chips": [{"truth_key": "count", "anchor": "bottom-left", "appear": 0.8}]
    },
    {
      "id": "end-card",
      "type": "end_card",
      "duration": 3.0,
      "transition": 0.7,
      "title": "REPLACE Product Title",
      "subtitle": "REPLACE Feature • Feature • Feature",
      "brand": "Ledger & Lime"
