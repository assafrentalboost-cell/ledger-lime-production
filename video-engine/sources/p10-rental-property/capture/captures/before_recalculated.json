{
 "Start Here": {
  "A1": "WELCOME \u2014 YOUR RENTAL PROPERTY SPREADSHEET",
  "A2": "One organized system for 1\u201310 rental properties: rent due vs. paid (with real partial-payment and carried-balance tracking), income & expenses, maintenance, deposits, capital improvements, a portfolio dashboard, and a year-end summary. Pre-loaded with realistic sample data so you can see it working before you enter your own numbers.",
  "A4": "Step 0 \u2014 Go to File > Make a Copy to save this to your own Google Drive. Always work from your own copy, never the original.",
  "A6": "QUICK NAVIGATION \u2014 click a tab name to jump there",
  "A7": "\u2192 Properties & Units",
  "A8": "\u2192 Tenants & Leases",
  "A9": "\u2192 Rent Tracker",
  "A10": "\u2192 Income & Expenses",
  "A11": "\u2192 Maintenance & Repairs",
  "A12": "\u2192 Deposits & Capital Improvements",
  "A13": "\u2192 Dashboard",
  "A14": "\u2192 Year-End Summary",
  "A16": "GET SET UP IN UNDER 5 MINUTES",
  "A17": "STEP 1: Go to Properties & Units \u2014 list each property and its units (1 unit for a single-family home, several for a duplex/fourplex).",
  "A18": "STEP 2: Go to Tenants & Leases \u2014 add each tenant, their unit, lease dates, and monthly rent.",
  "A19": "STEP 3: Go to Rent Tracker \u2014 add one row per unit per month. Record payments as they come in; balances carry forward automatically.",
  "A20": "STEP 4: Go to Income & Expenses \u2014 log everything else: repairs, insurance, property tax, management fees, other income.",
  "A21": "STEP 5: Check the Dashboard \u2014 rent due/collected/outstanding, cash flow, open maintenance, and expiring leases all update automatically from what you entered above.",
  "A24": "WHAT THE COLORS MEAN",
  "A25": "YELLOW",
  "B25": "YOU TYPE HERE.",
  "A26": "WHITE",
  "B26": "AUTOMATIC \u2014 calculated for you. Don't type over these.",
  "A28": "Google Sheets & Excel compatible \u2014 both included. Works on any computer, no software to install for the Google Sheets version.",
  "A30": "DISCLAIMER: This is an organizational and bookkeeping template only. It is not legal, tax, or accounting advice, and does not guarantee compliance with any landlord-tenant law. Always consult a qualified professional for legal or tax questions."
 },
